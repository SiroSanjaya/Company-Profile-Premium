{
  "name": "premium-react-template",
  "version": "1.0.0",
  "description": "Premium React.js Template - Modern, Responsive & Customizable",
  "private": true,
  "dependencies": {
    "@headlessui/react": "^1.7.19",
    "@heroicons/react": "^2.2.0",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "aos": "^2.3.4",
    "autoprefixer": "^10.4.21",
    "axios": "^1.11.0",
    "chart.js": "^4.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^7.10.3",
    "lodash": "^4.17.21",
    "lucide-react": "^0.263.1",
    "postcss": "^8.5.6",
    "prismjs": "^1.30.0",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.3.0",
    "react-copy-to-clipboard": "^5.1.0",
    "react-countup": "^6.5.3",
    "react-datepicker": "^4.25.0",
    "react-dom": "^18.3.1",
    "react-dropzone": "^14.3.8",
    "react-error-boundary": "^4.1.2",
    "react-helmet-async": "^1.3.0",
    "react-hook-form": "^7.61.1",
    "react-hot-toast": "^2.5.2",
    "react-intersection-observer": "^9.16.0",
    "react-lazy-load-image-component": "^1.6.3",
    "react-modal": "^3.16.3",
    "react-query": "^3.39.3",
    "react-refresh": "^0.17.0",
    "react-router-dom": "^6.30.1",
    "react-scripts": "^5.0.1",
    "react-select": "^5.10.2",
    "react-slick": "^0.29.0",
    "react-syntax-highlighter": "^15.6.1",
    "react-table": "^7.8.0",
    "react-tooltip": "^5.29.1",
    "react-use": "^17.6.0",
    "react-virtualized": "^9.22.6",
    "react-window": "^1.8.11",
    "slick-carousel": "^1.8.1",
    "swiper": "^9.4.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.17"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "test:coverage": "react-scripts test --coverage --watchAll=false --passWithNoTests",
    "test:watch": "react-scripts test --watch",
    "test:ci": "react-scripts test --coverage --watchAll=false --ci --passWithNoTests",
    "eject": "react-scripts eject",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "lint": "eslint src/",
    "lint:fix": "eslint --fix src/",
    "predev": "npm run format && npm run lint:fix",
    "fix-line-endings": "node fix-line-endings.js",
    "setup": "npm run fix-line-endings && npm run format && npm run lint:fix",
    "dev": "npm run format && npm run lint:fix && npm start",
    "fix-all": "npm run format && npm run lint:fix",
    "check-all": "npm run format:check && npm run lint",
    "quality-check": "npm run test:coverage && npm run check-all && npm run build",
    "prepublishOnly": "npm run quality-check",
    "build:analyze": "npm run build && npx serve -s build",
    "vercel-build": "npm install --legacy-peer-deps && next build",
    "analyze": "npm run build && npx webpack-bundle-analyzer build/static/js/*.js",
    "lighthouse": "npx lighthouse http://localhost:3000 --output=html --output-path=./lighthouse-report.html",
    "performance": "npm run build && npm run lighthouse"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "keywords": [
    "react",
    "template",
    "premium",
    "modern",
    "responsive",
    "landing-page",
    "business",
    "startup"
  ],
  "author": "Premium Template Creator",
  "license": "MIT",
  "devDependencies": {
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.3",
    "prettier": "^3.6.2"
  }
}
